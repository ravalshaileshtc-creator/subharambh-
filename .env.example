# ==============================================================================
# Panchmahal Events Hub - Environment Variables
# Expo SDK 50+ loads variables prefixed with EXPO_PUBLIC_ automatically!
# Copy this file to .env and replace with your real Supabase credentials.
# ==============================================================================

EXPO_PUBLIC_SUPABASE_URL=https://your-supabase-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
